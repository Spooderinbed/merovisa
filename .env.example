# The public origin this deployment is reachable at, e.g. https://merovisa.vercel.app.
# No trailing slash. It is what auth redirects and emailed sign-in links are built from,
# and it must also be listed under Supabase → Authentication → URL Configuration →
# Redirect URLs (see docs/email-auth-setup.md §3) or the emailed link is refused.
# REQUIRED in production. Leave it blank ONLY on Vercel, where the edge rewrites
# x-forwarded-host and the app can read the public host from it — that is also the one
# way Vercel previews get their per-deployment URL right. Behind any other proxy the
# header is unverified request data, so the app ignores it and falls back to its own
# internal URL, which sends students to the wrong host after sign-in.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role (used for privileged operations)
SUPABASE_SERVICE_ROLE_KEY=

# Dev-only auto sign-in. Set to "1" in local .env.local to enable
# /api/dev/sign-in. Route 404s unless ALL of the following are true:
#  - NODE_ENV !== "production"
#  - ENABLE_DEV_SIGNIN === "1"
#  - NEXT_PUBLIC_SUPABASE_URL points at a local or *.supabase.co dev project
# Optional override for the dev user's email (default: dev@merovisa.local).
ENABLE_DEV_SIGNIN=
DEV_USER_EMAIL=

# HMAC secret for signing OAuth claim tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# REQUIRED — server crashes if missing. Use 32+ characters.
CLAIM_HMAC_SECRET=

# Upstash Redis for rate limiting. Optional in dev (rate limits no-op
# when both vars are absent). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token Vercel Cron presents to /api/cron/purge-anonymous, which deletes
# unclaimed anonymous assessments (see docs/data-retention-policy.md). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Unlike the rate limiter, this gate FAILS CLOSED: while this is unset the route 404s
# and NOTHING is ever deleted — so an unset value is safe, but retention silently stops.
CRON_SECRET=

# Sentry (Plan 3)
SENTRY_DSN=

# PostHog (Plan 3)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
